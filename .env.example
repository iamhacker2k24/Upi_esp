# Server Configuration
PORT=5000

# Your Gmail address
EMAIL_USER=your_email@gmail.com

# 16-character Google App Password (spaces will be automatically removed by the app)
# Get this from: Google Account -> Security -> 2-Step Verification -> App passwords
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Target sender to filter emails by (defaults to dev@gmail.ocm if not set)
TARGET_SENDER=dev@gmail.ocm

# Optional: Default limit of emails to return (default: 10)
MAX_EMAILS=10
